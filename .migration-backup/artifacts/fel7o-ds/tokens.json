{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Fel7o Design System tokens — premium futuristic dark theme. Primary: electric cyan #00D4FF. Secondary/accent: violet #7C3AED. Background: near-black deep navy #050816. THIS FILE IS THE SINGLE SOURCE OF TRUTH. Edit here only; build-tokens.mjs generates src/index.css and src/generated/tokens.tsx.",
  "color": {
    "$type": "color",
    "light": {
      "background":           { "$value": "#F0F4FF", "$description": "Page background — light mode." },
      "foreground":           { "$value": "#050816", "$description": "Default text on light bg." },
      "card":                 { "$value": "#FFFFFF" },
      "cardForeground":       { "$value": "#050816" },
      "popover":              { "$value": "#FFFFFF" },
      "popoverForeground":    { "$value": "#050816" },
      "primary":              { "$value": "#0099CC", "$description": "Electric cyan — darkened for light-mode contrast." },
      "primaryForeground":    { "$value": "#FFFFFF" },
      "secondary":            { "$value": "#EEF0FF" },
      "secondaryForeground":  { "$value": "#050816" },
      "muted":                { "$value": "#EEF0FF" },
      "mutedForeground":      { "$value": "#6B7280" },
      "accent":               { "$value": "#6D28D9", "$description": "Violet accent — light mode." },
      "accentForeground":     { "$value": "#FFFFFF" },
      "destructive":          { "$value": "#DC2626" },
      "destructiveForeground":{ "$value": "#FFFFFF" },
      "border":               { "$value": "#D1D8F0" },
      "input":                { "$value": "#D1D8F0" },
      "ring":                 { "$value": "#0099CC" },
      "chart1":               { "$value": "#0099CC" },
      "chart2":               { "$value": "#6D28D9" },
      "chart3":               { "$value": "#059669" },
      "chart4":               { "$value": "#DC2626" },
      "chart5":               { "$value": "#D97706" },
      "sidebar":              { "$value": "#F8FAFF" },
      "sidebarForeground":    { "$value": "#374151" },
      "sidebarBorder":        { "$value": "#D1D8F0" },
      "sidebarPrimary":       { "$value": "#0099CC" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent":        { "$value": "#EEF0FF" },
      "sidebarAccentForeground": { "$value": "#050816" },
      "sidebarRing":          { "$value": "#0099CC" }
    },
    "dark": {
      "background":           { "$value": "#050816", "$description": "Deep navy — primary app background." },
      "foreground":           { "$value": "#FFFFFF" },
      "card":                 { "$value": "#0A0D1A", "$description": "Card surface — rgba(255,255,255,.05) on #050816." },
      "cardForeground":       { "$value": "#FFFFFF" },
      "popover":              { "$value": "#0A0D1A" },
      "popoverForeground":    { "$value": "#FFFFFF" },
      "primary":              { "$value": "#00D4FF", "$description": "Electric cyan — primary brand color." },
      "primaryForeground":    { "$value": "#050816" },
      "secondary":            { "$value": "#0D1220", "$description": "Slightly lifted dark surface." },
      "secondaryForeground":  { "$value": "#FFFFFF" },
      "muted":                { "$value": "#0D1220" },
      "mutedForeground":      { "$value": "#B5BFD0", "$description": "Soft blue-gray for secondary text." },
      "accent":               { "$value": "#7C3AED", "$description": "Violet — secondary brand and accent color." },
      "accentForeground":     { "$value": "#FFFFFF" },
      "destructive":          { "$value": "#FF4444" },
      "destructiveForeground":{ "$value": "#FFFFFF" },
      "border":               { "$value": "#1A2040", "$description": "Subtle border — rgba(255,255,255,.08) on #050816." },
      "input":                { "$value": "#1A2040" },
      "ring":                 { "$value": "#00D4FF" },
      "chart1":               { "$value": "#00D4FF" },
      "chart2":               { "$value": "#7C3AED" },
      "chart3":               { "$value": "#00FF88" },
      "chart4":               { "$value": "#FF6B6B" },
      "chart5":               { "$value": "#FFD700" },
      "sidebar":              { "$value": "#07091A", "$description": "Sidebar surface — darker than card." },
      "sidebarForeground":    { "$value": "#B5BFD0" },
      "sidebarBorder":        { "$value": "#1A2040" },
      "sidebarPrimary":       { "$value": "#00D4FF" },
      "sidebarPrimaryForeground": { "$value": "#050816" },
      "sidebarAccent":        { "$value": "#0D1220" },
      "sidebarAccentForeground": { "$value": "#FFFFFF" },
      "sidebarRing":          { "$value": "#00D4FF" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["Inter", "sans-serif"], "$description": "Primary UI and body typeface." },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono":  { "$value": ["Fira Code", "Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1.5rem",
      "$description": "24px base radius — premium rounded corners per Fel7o brand."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step the shadcn components multiply."
    }
  }
}
